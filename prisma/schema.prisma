// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  system      String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())

  sessions   Session[]
  npcs       NPC[]
  locations  Location[]
  items      Item[]
  characters Character[]

  @@index([ownerId])
}

model Session {
  id         String   @id @default(cuid())
  title      String
  date       DateTime
  summary    String?
  notes      String?
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // AI-generated summary (distinct from the user-authored `summary`) with audit metadata.
  aiSummary           String?
  aiSummaryModel      String?
  aiSummaryProvider   String?
  aiSummaryAt         DateTime?
  aiSummarySourceHash String?

  summaryJob SessionSummaryJob?

  @@index([campaignId])
}

// Queue of off-request session-summarization work. One job per session; the cron worker
// claims it, summarizes, and persists the result on the Session. Idempotent + retrying.
model SessionSummaryJob {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // pending | processing | done | failed
  attempts   Int      @default(0)
  sourceHash String
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

model NPC {
  id          String   @id @default(cuid())
  name        String
  role        String?
  description String?
  status      String
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Provenance: null for manual entry; "srd"/"agent" for enriched entities. `attribution`
  // holds the OGL/CC notice when the entity originates from the SRD.
  source      String?
  attribution String?

  ownedItems Item[]

  @@index([campaignId])
}

model Location {
  id          String   @id @default(cuid())
  name        String
  description String?
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Item {
  id          String   @id @default(cuid())
  name        String
  description String?
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ownerNpcId  String?
  ownerNpc    NPC?     @relation(fields: [ownerNpcId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([ownerNpcId])
}

model Character {
  id         String   @id @default(cuid())
  name       String
  playerName String
  class      String
  level      Int
  notes      String?
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Provenance: null for manual entry; "srd"/"agent" for enriched entities.
  source      String?
  attribution String?

  @@index([campaignId])
}

// The current user's own profile, 1:1 with the Supabase auth user (no Prisma relation — the
// auth user lives in Supabase's auth schema). `userId` is the auth uid and the primary key.
model Profile {
  userId      String   @id
  displayName String?
  avatarUrl   String?
  bio         String?
  locale      String?
  timezone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
